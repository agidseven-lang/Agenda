rules_version = '2';

// =====================================================================
// firestore.rules — Agenda ID Seven (deploy via GitLab CI/CD)
//
// Coleções em uso (auditadas no codigo do PWA, do app nativo e das Functions):
//   - users
//   - events
//   - tasks
//   - chats
//   - chats/{chatId}/messages   (SUBCOLECAO)
//   - briefs                    (PWA-only)
//   - passwordResetRequests     (app nativo; reset por administrador, 1.0.37+)
//
// MODELO DE AUTH: o produto NAO usa Firebase Auth — autenticacao eh custom
// via documento 'users/*' (campo 'pass'/'salt'). Portanto 'request.auth' eh
// SEMPRE null nos clientes; as regras nao podem depender dele.
//
// PRINCIPIOS:
//   - Reproduzir o comportamento existente em producao para nao quebrar PWA/app.
//   - Endurecer apenas 'passwordResetRequests' (coleção nova, schema fechado).
//   - Bloquear coleções nao listadas (default-deny no 'match /{document=**}').
//   - Limites de tamanho defensivos para impedir abuso (1 MiB por doc).
//
// IMPORTANTE — PRIMEIRA PUBLICACAO:
//   Estas regras foram montadas a partir do uso conhecido do codigo, NAO
//   foram extraidas da producao. Antes de rodar 'deploy_firestore_rules'
//   pela primeira vez, rode o job 'dump_firestore_rules' no GitLab — ele
//   baixa as regras de prod via API (sem voce copiar/colar) e salva como
//   artifact 'firestore.rules.from-prod'. Compare com este arquivo; se
//   houver validacoes especificas em prod que nao estao aqui, traga-as
//   para ca antes do deploy. So entao rode 'deploy_firestore_rules'.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------
    // users — cadastro do PWA cria; login le; profile atualiza
    // PWA: db.collection("users").add({...}) ; .doc(id).update({pass,salt,...})
    // App: AuthRepo lê/atualiza users; sem request.auth confiavel
    // ----------------------------------------------------------------
    match /users/{userId} {
      allow read, list: if true;
      allow create: if request.resource.size() < 1048576;
      allow update: if request.resource.size() < 1048576;
      allow delete: if false;
    }

    // ----------------------------------------------------------------
    // events — agenda; criados/editados/excluidos por PWA e app
    // ----------------------------------------------------------------
    match /events/{eventId} {
      allow read, list: if true;
      allow create, update: if request.resource.size() < 1048576;
      allow delete: if true;
    }

    // ----------------------------------------------------------------
    // tasks — tarefas; idem events
    // ----------------------------------------------------------------
    match /tasks/{taskId} {
      allow read, list: if true;
      allow create, update: if request.resource.size() < 1048576;
      allow delete: if true;
    }

    // ----------------------------------------------------------------
    // chats — sala de conversa; PWA e app leem/criam/atualizam
    // subcolecao messages logo abaixo
    // ----------------------------------------------------------------
    match /chats/{chatId} {
      allow read, list: if true;
      allow create, update: if request.resource.size() < 1048576;
      allow delete: if true;

      match /messages/{messageId} {
        allow read, list: if true;
        allow create, update: if request.resource.size() < 1048576;
        allow delete: if true;
      }
    }

    // ----------------------------------------------------------------
    // briefs — PWA (gestao de briefs); chave = slug
    // ----------------------------------------------------------------
    match /briefs/{briefId} {
      allow read, list: if true;
      allow create, update: if request.resource.size() < 1048576;
      allow delete: if true;
    }

    // ----------------------------------------------------------------
    // passwordResetRequests — reset por administrador (1.0.37+)
    //
    // - Cliente cria UMA solicitacao com schema EXATO.
    // - Cliente NAO le, NAO lista, NAO atualiza, NAO apaga.
    // - Triagem fica no Console Firebase (admin do projeto).
    // ----------------------------------------------------------------
    match /passwordResetRequests/{reqId} {
      allow read, list: if false;
      allow update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'identifier','kind','phoneDigits','createdAt',
          'status','source','handledBy','handledAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'identifier','kind','phoneDigits','createdAt',
          'status','source','handledBy','handledAt'
        ]) &&
        request.resource.data.identifier is string &&
        request.resource.data.identifier.size() >= 3 &&
        request.resource.data.identifier.size() <= 120 &&
        request.resource.data.kind is string &&
        (request.resource.data.kind == 'email' ||
         request.resource.data.kind == 'phone') &&
        request.resource.data.phoneDigits is string &&
        request.resource.data.phoneDigits.size() <= 20 &&
        (request.resource.data.kind != 'phone' ||
         request.resource.data.phoneDigits.size() >= 8) &&
        request.resource.data.createdAt is number &&
        request.resource.data.createdAt > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'nativebeta' &&
        request.resource.data.handledBy == null &&
        request.resource.data.handledAt == null;
    }

    // ----------------------------------------------------------------
    // Default-deny — qualquer coleção nao listada acima e bloqueada.
    // ----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
